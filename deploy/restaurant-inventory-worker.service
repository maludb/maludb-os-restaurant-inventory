[Unit]
Description=Restaurant Inventory worker: due POS pulls and the email intake, depletion runs, the nightly forecast pass, suggested orders ahead of each cut-off, price alerts, watches, the outbox, dispatches to agents, link expiry (one pass)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}
ExecStart=/usr/bin/php {{APP_DIR}}/bin/worker.php
