{
    "schema": "maludb-os.application/1",
    "catalog_key": "restaurant_inventory",
    "name": "Restaurant Inventory",
    "description": "The kitchen's and the bar's stock desk: what the restaurant buys, in the units it buys, counts and cooks it in; recipes with sub-recipes and yields so every plate has a cost as of any date; purchase orders and receiving at a known cost; the POS's sales depleting stock through the recipes; waste, transfers, prep batches and physical counts by storage area; usage periods showing actual against theoretical with every bucket; and the projection — expected sales exploded through recipes into expected usage, projected stock per ingredient per day, and one suggested order per supplier for its next delivery with the arithmetic on every line. Every restaurant is a site. Two shipped agents, the Kitchen Inventory Expert and the Purchasing agent, answer and draft; sending a purchase order pauses for a person.",
    "business_area": "Operations",
    "category": "inventory",
    "icon": "feather-coffee",
    "version": "0.1.0",
    "criticality": "medium",
    "vhost": {
        "label": "kitchen",
        "document_root": "html",
        "internal_port_env": "APP_INTERNAL_PORT"
    },
    "database": {
        "suffix": "restaurant_inventory",
        "migrations": "db",
        "roles": {
            "rw": "restaurant_inventory_rw",
            "records_ro": "restaurant_inventory_records_ro",
            "activity_ro": "restaurant_inventory_activity_ro"
        }
    },
    "env": {
        "required": [
            "APP_NAME",
            "APP_URL",
            "DB_HOST",
            "DB_PORT",
            "DB_NAME",
            "DB_USER",
            "DB_PASSWORD",
            "MCP_RECORDS_DB_USER",
            "MCP_RECORDS_DB_PASSWORD",
            "MCP_ACTIVITY_DB_USER",
            "MCP_ACTIVITY_DB_PASSWORD",
            "APP_INTERNAL_PORT",
            "MCP_RECORDS_PORT",
            "MCP_ACTIVITY_PORT",
            "ACTION_TOKEN_KEY",
            "ACTIONS_RELAY_KEY",
            "OS_APPLICATION_TOKEN",
            "OS_INTERNAL_URL",
            "OS_LAUNCHER_URL",
            "APP_KEY",
            "MALUDB_API_URL",
            "MALUDB_API_TOKEN",
            "RI_SECRETS_KEY"
        ],
        "optional": [
            "MALUMAIL_API_KEY",
            "MALUMAIL_API_URL",
            "MAIL_FROM",
            "MAIL_FROM_NAME",
            "RI_INTAKE_MAILBOX",
            "ATTACHMENT_MAX_BYTES",
            "RI_PUBLIC_BASE_URL",
            "RI_MANAGER_EMAIL",
            "API_CORS_ORIGINS"
        ]
    },
    "services": [
        "deploy/restaurant-inventory-records-mcp.service",
        "deploy/restaurant-inventory-activity-mcp.service",
        "deploy/restaurant-inventory-activity-ingest.service",
        "deploy/restaurant-inventory-activity-ingest.timer",
        "deploy/restaurant-inventory-directory-sync.service",
        "deploy/restaurant-inventory-directory-sync.timer",
        "deploy/restaurant-inventory-worker.service",
        "deploy/restaurant-inventory-worker.timer"
    ],
    "endpoints": [
        {
            "name": "Web UI",
            "kind": "ui",
            "path": "/",
            "auth_kind": "none",
            "agent_reachable": false
        },
        {
            "name": "Health",
            "kind": "http_api",
            "path": "/api/v1/health",
            "auth_kind": "none",
            "agent_reachable": false
        },
        {
            "name": "Supplier order page",
            "kind": "ui",
            "path": "/s/",
            "auth_kind": "none",
            "agent_reachable": false
        },
        {
            "name": "Records MCP",
            "kind": "mcp",
            "path": "/mcp/records",
            "port_env": "MCP_RECORDS_PORT",
            "auth_kind": "bearer",
            "agent_reachable": true,
            "mcp_surface_version": "1.0"
        },
        {
            "name": "Activity MCP",
            "kind": "mcp",
            "path": "/mcp/activity",
            "port_env": "MCP_ACTIVITY_PORT",
            "auth_kind": "bearer",
            "agent_reachable": true,
            "mcp_surface_version": "1.0"
        }
    ],
    "actions": {
        "manifest": "docs/restaurant-inventory-action-manifest.md",
        "registry": "mcp/action_registry.json",
        "base_url_env": "APP_INTERNAL_PORT"
    },
    "skills": [
        "skills/kitchen-inventory-basics",
        "skills/units-and-yields",
        "skills/costing-a-recipe",
        "skills/reading-variance",
        "skills/ordering",
        "skills/counting",
        "skills/morning-note",
        "skills/suggested-order-run",
        "skills/post-count-review",
        "skills/price-check",
        "skills/plu-queue",
        "skills/recipe-from-dictation"
    ],
    "sso": {
        "path": "/sso",
        "logout_path": "/sso/logout"
    },
    "directory": {
        "reads": true,
        "writes": false
    },
    "assistant": {
        "command_bar": true,
        "agent": "expert"
    },
    "scopes": {
        "kind": "location"
    },
    "grant_standing_departments": false,
    "shares": [
        {
            "tool": "purchases_received",
            "description": "Goods receipts in a period at cost by supplier, for the General Ledger's bills with the site set (os.restaurant-inventory-purchases/1)",
            "scoped": true,
            "timeout_seconds": 20
        },
        {
            "tool": "stock_valuation",
            "description": "Stock at cost as of a date by storage area and category at one site, for the ledger's inventory asset at close (os.restaurant-inventory-valuation/1)",
            "scoped": true,
            "timeout_seconds": 20
        },
        {
            "tool": "cogs_summary",
            "description": "A closed period's actual and theoretical usage at cost by category at one site, waste separated, for the ledger's cost of goods (os.restaurant-inventory-cogs/1)",
            "scoped": true,
            "timeout_seconds": 20
        },
        {
            "tool": "waste_summary",
            "description": "Waste in a period by stage and reason at cost at one site (os.restaurant-inventory-waste/1)",
            "scoped": true,
            "timeout_seconds": 20
        },
        {
            "tool": "sales_by_day",
            "description": "Net sales and covers per day and day part at one site from the imported POS checks, for the ledger's daily sales journal and txtSchedules' actual covers (os.restaurant-inventory-sales/1)",
            "scoped": true,
            "timeout_seconds": 20
        },
        {
            "tool": "ingredients_index",
            "description": "The ingredients a site stocks — names, codes, units, categories — without quantities or cost, for Spaces and Help Desk to link (os.restaurant-inventory-ingredients/1)",
            "scoped": true,
            "timeout_seconds": 20
        }
    ],
    "reads": [
        {
            "app": "reservations",
            "tool": "covers_by_service",
            "why": "Booked covers per service for the usage projection (design §6.8, D8); degraded to none on no_connection"
        }
    ],
