# Restaurant Inventory — config/.env (written by the kernel's installer at apply; the three ports pinned first by deploy/ROOT_STEPS.sh;
# design §14). Never commit the real file. Group www-data reads it; nothing in it is ever logged, printed or returned.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Restaurant Inventory"
APP_KEY=restaurant_inventory
APP_URL=https://kitchen.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_restaurant_inventory
DB_USER=restaurant_inventory_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=restaurant_inventory_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=restaurant_inventory_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (all three pinned before the first apply: deploy/ROOT_STEPS.sh; design §14, D16)
APP_INTERNAL_PORT=8200
MCP_RECORDS_PORT=8856
MCP_ACTIVITY_PORT=8857
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes: ids, quantities and states, never a POS payload)
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# the POS sources' credentials are sealed under this key (the installer generates it; 32 random bytes, hex) — never rotate it by hand
RI_SECRETS_KEY=
# notification mail (optional; the installer fills them from ~/.malumail or the kernel's): purchase orders to suppliers with their
# secure link, price alerts, the morning note's copy — sent through MaluMail's REST API like every sibling's
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# the attachment store (default storage/ under the application; www-data writes it): receipts' photos, invoices, waste photos
RI_STORAGE_DIR=storage
ATTACHMENT_MAX_BYTES=26214400
# the doors' absolute links (the supplier's /s/<token>); defaults to APP_URL
RI_PUBLIC_BASE_URL=
# the POS email intake at MaluMail (optional): a mailbox the worker reads sales exports from
RI_INTAKE_MAILBOX=
# the Manager the Purchasing agent's morning note goes to (seeds ri_settings.manager_member_id at install; the first super-admin until then — D14)
RI_MANAGER_EMAIL=
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
